{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nanu-aesthetics.vercel.app" }],
      "destination": "https://nanu-aesthetics.de/",
      "permanent": true
    },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "nanu-aesthetics-nanu-ae.vercel.app" }],
      "destination": "https://nanu-aesthetics.de/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nanu-aesthetics.vercel.app" }],
      "destination": "https://nanu-aesthetics.de/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "nanu-aesthetics-nanu-ae.vercel.app" }],
      "destination": "https://nanu-aesthetics.de/:path*",
      "permanent": true
    }
  ]
}
